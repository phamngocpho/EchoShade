  tierUpLines:
  - 
  - "L\u1ECBch t\xE0u \u0111\xE3 \u0111\u01B0\u1EE3c \u0111i\u1EC1u ch\u1EC9nh. T\xE0u
    s\u1EBD ch\u1EA1y s\u1EDBm h\u01A1n."
  - "T\xF4i nh\u1EDB anh \u0111\xE3 \u0111i l\u1ED1i n\xE0o. T\xF4i s\u1EBD \u0111\u1EE3i
    \u1EDF \u0111\xF3."
  ghostLine: 
  zones:
  - name: L2_TrainZone
    fromTime: 3
    toTime: 7.5
    hint: "T\xE0u ch\u1EA1y \u1EDF l\xE0n g\u1EA7n. C\u1EA7m th\xF9ng r\u1ED3i chuy\u1EC3n
