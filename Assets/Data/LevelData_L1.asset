  - 
  - "\u0110\xE3 ghi nh\u1EADn. L\u1EA7n n\xE0y c\xE0ng m\xE1y s\u1EBD \u0111\u1EBFn
    s\u1EDBm h\u01A1n."
  ghostLine: 
  zones:
  - name: L1_Ton
    fromTime: 0
    toTime: 2.4
    hint: "T\u1EA5m t\xF4n r\u01A1i ch\u1EAFn l\xE0n g\u1EA7n \u1EDF G2: \u0111\u1ED5i
