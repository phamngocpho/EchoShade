  levelIndex: 4
  displayName: "M\xE0n 4"
  placeName: "X\u01B0\u1EDFng L\u1ECBch"
  rulerSeconds: 16
  entryTier: 1
  tierCap: 3
  objective: "C\u1EEDa x\u01B0\u1EDFng (G12) ch\u1EC9 m\u1EDF khi c\xF3 ng\u01B0\u1EDDi
    \u0111\u1EE9ng tr\xEAn b\xE0n \u0111\u1EA1p c\u1EA3m bi\u1EBFn (G7,5\u20138,8).
    H\xE3y \u0111\u1EC3 \u1EA2nh v\u1ECDng \u0111\u1EE9ng thay anh."
  startLine: "X\u01B0\u1EDFng n\xE0y l\xE0m ra l\u1ECBch cho c\u1EA3 th\xE0nh ph\u1ED1.
    C\u1EEDa ch\u1EC9 m\u1EDF cho ng\u01B0\u1EDDi \u0111\u1EE9ng \u0111\xFAng ch\u1ED7."
  tierUpLines:
  - 
  - 
  - "\u0110\xE3 ghi nh\u1EADn. Gi\xE1 treo s\u1EBD r\u01A1i \u0111\xFAng l\xE0n anh
    \u0111i."
  - "L\xF9i \u0111\u1EE7 xa hai l\u1EA7n \u0111\u1EC3 NH\u1ECAP g\u1ECDi \u1EA2nh
    v\u1ECDng. T\xF4i thu\u1ED9c \u0111\u01B0\u1EDDng anh r\u1ED3i \u2014 b\xF3ng
    c\u1EE7a anh s\u1EBD \u0111i tr\u01B0\u1EDBc."
  ghostLine: "B\xF3ng n\xE0y kh\xF4ng \u0111\xF2i g\xEC. N\xF3 ch\u1EC9 \u0111\u1EE9ng
    \u1EDF ch\u1ED7 anh t\u1EEBng \u0111\u1EE9ng."
  zones:
  - name: L4_Vao
    fromTime: 0
    toTime: 4
    hint: "B\xE0n \u0111\u1EA1p c\u1EA3m bi\u1EBFn ch\u1EC9 nh\u1EADn ng\u01B0\u1EDDi,
      kh\xF4ng nh\u1EADn th\xF9ng."
  - name: L4_Pedal
    fromTime: 4
    toTime: 9
    hint: "Gi\xE1 treo r\u01A1i \u1EDF l\xE0n NH\u1ECAP nh\u1EDB (v\xF2ng \u0111\u1ECF
      G6) \u2014 \u0111\u1ED5i l\xE0n \u0111\u1EC3 n\xE9. \u0110\u1EE9ng tr\xEAn
      b\xE0n \u0111\u1EA1p r\u1ED3i l\xF9i m\u1ED9t m\u1EA1ch v\u1EC1 \u0111\u1EA7u
      x\u01B0\u1EDFng: l\u1EA7n l\xF9i th\u1EE9 hai NH\u1ECAP l\xEAn b\u1EADc 3 v\xE0
      g\u1ECDi \u1EA2nh v\u1ECDng \u0111i l\u1EA1i \u0111\xFAng \u0111\u01B0\u1EDDng
      anh v\u1EEBa \u0111i."
  - name: L4_Cua
    fromTime: 9
    toTime: 16
    hint: "L\xE0n xa G9\u2013G13 l\xE0 h\u1ED1 b\xE1nh r\u0103ng. Ch\u1EC9 qua \u0111\u01B0\u1EE3c
      b\u1EB1ng l\xE0n g\u1EA7n khi c\u1EEDa m\u1EDF."
  marks:
  - time: 2
    label: "Th\xF9ng"
    lane: 0
  - time: 6
    label: "Gi\xE1 treo"
    lane: -1
  - time: 7.5
    label: "B\xE0n \u0111\u1EA1p"
    lane: 0
  - time: 9
    label: "H\u1ED1 b\xE1nh r\u0103ng"
    lane: 1
  - time: 12
    label: "C\u1EEDa x\u01B0\u1EDFng"
    lane: 0
  - time: 16
    label: "Th\xF9ng th\u01B0"
    lane: -1
  ghostSpeedFactor: 0.6
  solution: "1) \u0110i l\xE0n g\u1EA7n t\u1EDBi b\xE0n \u0111\u1EA1p G8 (c\u1EEDa
    m\u1EDF khi anh \u0111\u1EE9ng \u0111\xF3, \u0111\xF3ng khi anh r\u1EDDi \u0111i).\n2)
    L\xF9i m\u1ED9t m\u1EA1ch v\u1EC1 kho\u1EA3ng G2 (l\u1EA7n l\xF9i 1 > b\u1EADc
    2; gi\xE1 treo G6 b\u1EAFt \u0111\u1EA7u r\u01A1i v\xE0o l\xE0n anh v\u1EEBa
    \u0111i).\n3) \u0110i l\u1EA1i: \u0111\u1ED5i l\xE0n \u1EDF G5 \u0111\u1EC3 n\xE9
    gi\xE1 treo, v\u1EC1 l\xE0n g\u1EA7n \u1EDF G7, \u0111\u1EE9ng tr\xEAn b\xE0n
    \u0111\u1EA1p \u1EDF G8.\n4) L\xF9i m\u1ED9t m\u1EA1ch v\u1EC1 G2 (l\u1EA7n l\xF9i
    2 > b\u1EADc 3): \u1EA2nh v\u1ECDng xu\u1EA5t hi\u1EC7n v\xE0 \u0111i l\u1EA1i
    \u0111\xFAng \u0111\u01B0\u1EDDng \u0111\xF3 r\u1ED3i \u0111\u1EE9ng tr\xEAn
    b\xE0n \u0111\u1EA1p.\n5) \u0110\u1EE9ng y\xEAn ch\u1EDD b\xF3ng t\u1EDBi b\xE0n
    \u0111\u1EA1p (c\u1EEDa m\u1EDF), r\u1ED3i \u0111i: n\xE9 gi\xE1 treo, v\u01B0\u1EE3t
    b\xF3ng b\u1EB1ng l\xE0n xa \u1EDF G8,5, v\u1EC1 l\xE0n g\u1EA7n tr\u01B0\u1EDBc
    G9, qua c\u1EEDa G12 t\u1EDBi th\xF9ng th\u01B0 G16.\nBi\u1EBFn th\u1EC3: \u0111\u1EB7t
    th\xF9ng (v\u1EADt neo) ngay sau b\xE0n \u0111\u1EA1p \u2014 b\xF3ng va v\xE0o
    th\xF9ng v\xE0 \u0111\u1EE9ng l\u1EA1i tr\xEAn b\xE0n \u0111\u1EA1p."
