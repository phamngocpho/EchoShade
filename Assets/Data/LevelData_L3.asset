  tierCap: 2
  objective: "\u0110\u1EB7t th\xF9ng l\xEAn b\xE0n \u0111\u1EA1p t\u1EA3i (G6, l\xE0n
    xa) \u0111\u1EC3 h\u1EA1 c\u1EA7u, qua k\xEAnh, v\u01B0\u1EE3t b\xE3i container
    v\xE0 giao th\u01B0 \u1EDF G19,6."
  startLine: "C\u1EA7u n\xE2ng \u0111\xFAng gi\u1EDD. Anh th\xEC c\u1EE9 \u0111i
    t\xECm ch\u1ED7 \u0111\u1EC3 th\xF9ng."
  tierUpLines:
  - 
  - "\u0110\xE3 ghi nh\u1EADn. T\xF4i nh\u1EDB anh \u0111i l\xE0n n\xE0o qua c\u1EA7u."
  - "L\u1EA7n sau t\xF4i treo m\xF3c \u0111\xFAng ch\u1ED7 anh s\u1EBD \u0111\u1EE9ng."
  ghostLine: 
  zones:
  - name: L3_Ben
    fromTime: 0
    toTime: 9.9
    hint: "C\u1EA7u c\u1EA7n m\u1ED9t th\u1EE9 n\u1EB7ng: mang th\xF9ng \u1EDF G3
      sang l\xE0n xa v\xE0 \u0111\u1EB7t l\xEAn b\xE0n \u0111\u1EA1p t\u1EA3i \u1EDF
      G6."
  - name: L3_Bridge
    fromTime: 10
    toTime: 14
    hint: "M\xF3c c\u1EA9u r\u01A1i xu\u1ED1ng l\xE0n NH\u1ECAP nh\u1EDB (v\xF2ng
      \u0111\u1ECF \u1EDF G12,5). Container nh\u1EA5c l\xEAn \u1EDF G11,5 \u2014
      qua c\u1EA7u r\u1ED3i \u0111\u1ED5i sang l\xE0n kia \u0111\u1EC3 tr\xE1nh m\xF3c."
  - name: L3_Cuoi
    fromTime: 14
    toTime: 16
    hint: "Th\xF9ng th\u01B0 gi\u1EEFa \u1EDF G16. Ph\xEDa sau l\xE0 b\xE3i container."
  - name: L3_Bai
    fromTime: 16
    toTime: 20
    hint: "L\xE0n xa b\u1ECB container ch\u1EAFn t\u1EDBi G18. Nh\u1EA3y qua \u0111\u1ED1ng
      th\xF9ng th\u1EA5p (Space) \u1EDF G17; qua G18 th\xEC \u0111\u1ED5i sang l\xE0n
      kia \u0111\u1EC3 n\xE9 m\xF3c c\u1EA9u \u1EDF G18,7 (v\xF2ng \u0111\u1ECF)."
