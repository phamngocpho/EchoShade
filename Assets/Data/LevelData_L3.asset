  tierCap: 2
  objective: "\u0110\u1EB7t th\xF9ng l\xEAn b\xE0n \u0111\u1EA1p t\u1EA3i (G6, l\xE0n
    xa) \u0111\u1EC3 h\u1EA1 c\u1EA7u, qua k\xEAnh, giao th\u01B0 \u1EDF G16."
  startLine: "B\u1EBFn n\xE0y ch\u1EA1y theo l\u1ECBch c\u1EA9u. C\u1EA7u ch\u1EC9
    h\u1EA1 khi c\xF3 h\xE0ng n\u1EB7ng \u2014 v\xE0 t\xF4i \u0111ang \u0111\u1EBFm
    t\u1EEBng b\u01B0\u1EDBc c\u1EE7a anh."
  tierUpLines:
  - 
  - "\u0110\xE3 ghi nh\u1EADn. T\xF4i nh\u1EDB anh \u0111i l\xE0n n\xE0o qua c\u1EA7u."
  - "L\u1EA7n sau t\xF4i treo m\xF3c \u0111\xFAng ch\u1ED7 anh s\u1EBD \u0111\u1EE9ng."
  ghostLine: 
  zones:
  - name: L3_Ben
    fromTime: 0
    toTime: 9.9
    hint: "C\u1EA7u c\u1EA7n m\u1ED9t th\u1EE9 n\u1EB7ng: mang th\xF9ng \u1EDF G3
