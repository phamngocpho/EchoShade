  bannerText: {fileID: 63180088}
  hintText: {fileID: 893034273}
  objective: "C\u1EEDa x\u01B0\u1EDFng (G12) ch\u1EC9 m\u1EDF khi c\xF3 ng\u01B0\u1EDDi
    \u0111\u1EE9ng tr\xEAn b\xE0n \u0111\u1EA1p c\u1EA3m bi\u1EBFn (G7,5\u20138,8).
    H\xE3y \u0111\u1EC3 \u1EA2nh v\u1ECDng \u0111\u1EE9ng thay anh."
  startLine: "X\u01B0\u1EDFng n\xE0y l\xE0m ra l\u1ECBch cho c\u1EA3 th\xE0nh ph\u1ED1.
    C\u1EEDa ch\u1EC9 m\u1EDF cho ng\u01B0\u1EDDi \u0111\u1EE9ng \u0111\xFAng ch\u1ED7."
  startLineDuration: 7
  tierUpLine: "\u0110\xE3 ghi nh\u1EADn. T\xF4i nh\u1EDB th\xEAm m\u1ED9t b\u01B0\u1EDBc
    c\u1EE7a anh."
  tierUpLines:
  - 
  - 
  - "\u0110\xE3 ghi nh\u1EADn. Gi\xE1 treo s\u1EBD r\u01A1i \u0111\xFAng l\xE0n anh
    \u0111i."
  - "L\xF9i \u0111\u1EE7 xa hai l\u1EA7n \u0111\u1EC3 NH\u1ECAP g\u1ECDi \u1EA2nh
    v\u1ECDng. T\xF4i thu\u1ED9c \u0111\u01B0\u1EDDng anh r\u1ED3i \u2014 b\xF3ng
    c\u1EE7a anh s\u1EBD \u0111i tr\u01B0\u1EDBc."
