--- !u!114 &280580957
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 280580955}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Th\u1EDDi gian = v\u1ECB tr\xED.</b> \u0110i t\u1EDBi (D) th\xEC th\u1EDDi
    gian ch\u1EA1y, l\xF9i l\u1EA1i (A) th\xEC th\u1EDDi gian tua ng\u01B0\u1EE3c,
    \u0111\u1EE9ng im th\xEC th\xE0nh ph\u1ED1 n\xEDn th\u1EDF. \u0110\u1ED5i l\xE0n
    (W/S) v\xE0 nh\u1EA3y (Space) kh\xF4ng l\xE0m th\u1EDDi gian tr\xF4i.\n<b>NH\u1ECAP
    h\u1ECDc anh.</b> M\u1ED7i l\u1EA7n l\xF9i m\u1ED9t m\u1EA1ch \u0111\u1EE7 xa
    (t\u1EEB 2 gi\xE2y tr\xEAn th\u01B0\u1EDBc tr\u1EDF l\xEAn), NH\u1ECAP nh\u1EDB
    anh \u0111\xE3 \u0111i l\xE0n n\xE0o, d\u1EEBng \u1EDF \u0111\xE2u, v\xE0 l\xEAn
    m\u1ED9t b\u1EADc: xanh > v\xE0ng > cam > \u0111\u1ECF. V\xF2ng \u0111\u1ECF
    tr\xEAn s\xE0n b\xE1o n\u01A1i n\xF3 s\u1EBD ra tay.\n<b>\u0110\u1ED3 v\u1EADt.</b>
    \u0110\u1ED3 trong l\u1ECBch (t\xE0u, c\u1EA9u, gi\xE1 treo\u2026) ch\u1EA1y
    theo th\u1EDDi gian. V\u1EADt neo (th\xF9ng, m\xF3c) \u2014 khi anh \u0111\u1EB7t
    xu\u1ED1ng (E) \u2014 n\u1EB1m ngo\xE0i th\u1EDDi gian: anh tua th\xEC n\xF3
    v\u1EABn \u1EDF y\xEAn. V\u1EADt r\u01A1i kh\u1ECFi s\xE2n kh\u1EA5u s\u1EBD
    t\u1EF1 H\u1ED3i v\u1ECB v\u1EC1 ch\u1ED7 c\u0169.\n<b>B\xE0n \u0111\u1EA1p.</b>
    B\xE0n \u0111\u1EA1p t\u1EA3i nh\u1EADn v\u1EADt n\u1EB7ng; b\xE0n \u0111\u1EA1p
    c\u1EA3m bi\u1EBFn ch\u1EC9 nh\u1EADn ng\u01B0\u1EDDi \u2014 ho\u1EB7c b\xF3ng
    c\u1EE7a anh.\n<b>\u1EA2nh v\u1ECDng.</b> \u1EDE b\u1EADc 3, m\u1ED7i l\u1EA7n
    anh l\xF9i \u0111\u1EE7 xa, NH\u1ECAP g\u1ECDi m\u1ED9t c\xE1i b\xF3ng \u0111i
    l\u1EA1i \u0111\xFAng \u0111\u01B0\u1EDDng anh v\u1EEBa \u0111i. B\xF3ng \u0111\u1EE9ng
    tr\xEAn b\xE0n \u0111\u1EA1p \u0111\u01B0\u1EE3c, k\xE9o \u0111\u01B0\u1EE3c
    m\u1EAFt th\xE1p, v\xE0 b\u1ECB v\u1EADt neo ch\u1EB7n l\u1EA1i.\n<b>M\xE1u v\xE0
    th\xF9ng th\u01B0.</b> Anh c\xF3 3 m\xE1u. H\u1EBFt m\xE1u (ho\u1EB7c b\u1EA5m
    R) th\xEC v\u1EC1 th\xF9ng th\u01B0 g\u1EA7n nh\u1EA5t: NH\u1ECAP h\u1EA1 m\u1ED9t
    b\u1EADc v\xE0 qu\xEAn \u0111i\u1EC1u v\u1EEBa h\u1ECDc.\n<b>Ph\xEDm:</b> A/D
    \u0111i \xB7 W/S \u0111\u1ED5i l\xE0n \xB7 Space nh\u1EA3y / v\u01B0\u1EE3t v\u1EADt
    th\u1EA5p \xB7 E nh\u1EB7t / \u0111\u1EB7t / giao th\u01B0 \xB7 R v\u1EC1 th\xF9ng
    th\u01B0 \xB7 Esc t\u1EA1m d\u1EEBng (M: v\u1EC1 menu)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 20de1db5f97c8a744a0e2db6f4e51b7d, type: 2}
